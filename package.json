{
  "name": "humanspan",
  "version": "0.1.1",
  "description": "Parse human-readable time expressions into any unit, and format durations into human-readable strings",
  "keywords": [
    "convert",
    "duration",
    "format",
    "human-readable",
    "milliseconds",
    "ms",
    "parse",
    "time"
  ],
  "homepage": "https://github.com/adelrodriguez/humanspan#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/humanspan/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelrodriguez/humanspan.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "build:debug": "bunup --sourcemap inline --no-minify",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch --sourcemap inline --no-minify",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14",
    "adamantite": "0.34.2",
    "bunup": "0.16.32",
    "fast-check": "4.9.0",
    "knip": "6.31.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
